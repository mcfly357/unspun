DATABASE_URL="file:./dev.db"

# Get a key at https://console.anthropic.com/ — without it the pipeline
# falls back to a basic non-LLM synthesis so the app still runs end to end.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Free key at https://unsplash.com/developers (create an app, use the
# "Access Key"). Without it, stories use the abstract topic-art fallback
# instead of a real stock photo.
UNSPLASH_ACCESS_KEY=
